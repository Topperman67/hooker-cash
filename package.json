{
  "name": "quantpad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/start.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "format": "prettier --write src server shared tests api vite.config.js playwright.config.js index.html README.md DESIGN.md \"docs/*.md\"",
    "format:check": "prettier --check src server shared tests api vite.config.js playwright.config.js index.html README.md DESIGN.md \"docs/*.md\"",
    "program:build": "bash scripts/anchor-docker.sh build",
    "program:test": "node programs/quantum-hooks/tests/run-local.mjs",
    "program:unit": "bash scripts/anchor-docker.sh unit",
    "meteora:check": "node scripts/meteora-upgrade-check.mjs"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@fontsource-variable/hubot-sans": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@meteora-ag/cp-amm-sdk": "1.5.1",
    "@meteora-ag/dynamic-bonding-curve-sdk": "1.5.13",
    "@noble/hashes": "^1.8.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-standard-features": "^1.5.0",
    "@solana/web3.js": "^1.99.0",
    "@vercel/functions": "^3.9.8",
    "@wallet-standard/app": "^1.1.1",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.46.0",
    "quick-liquid": "^0.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.7",
    "vite": "^6.0.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "overrides": {
    "rpc-websockets": {
      "uuid": "11.1.1"
    }
  }
}
