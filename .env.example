# Server-only configuration. Never put secrets in VITE_ variables.

# Public origin, a full http(s) URL. Token metadata URIs are written on-chain and must keep
# resolving forever. A standalone server (npm start, npm run preview) refuses /api/media and
# /api/metadata with 503 PUBLIC_URL_UNSET unless this or PINATA_JWT is set (it never uses the Host
# header; only localhost, 127.0.0.1 and [::1] work without it). On Vercel the default is the
# project's production domain.
# The build also reads it (or VITE_PUBLIC_URL) for absolute og:image / og:url link-preview tags.
QUANTPAD_PUBLIC_URL=https://your-domain.example

# Solana RPC used by the server and the browser proxy (/api/rpc). Use a provider endpoint
# (Helius, Triton, QuickNode…) in production; the public endpoint is heavily rate limited.
# QUANTPAD_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Optional RPC budget shared by all visitors, in calls per minute (unset: none). /api/rpc counts
# its calls; tracking a coin the server does not know yet and each coin sync from POST /api/sync
# count 45. Keep it below the provider plan's rate, with room for the indexer and keeper.
# QUANTPAD_RPC_GLOBAL_PER_MIN=3000

# Platform trading fee, charged as a visible transfer on trades and dev buys made in Quant Pad.
# Off unless a treasury is set. Basis points, capped at 200 (2%). Send the treasury at least
# 0.001 SOL (the 890,880 lamport rent-exempt minimum) first; until then fees below that are skipped.
# QUANTPAD_TREASURY=YourTreasuryWalletAddress
# QUANTPAD_FEE_BPS=50

# Address lookup table that lets a launch + dev buy fit in one transaction. Required for any launch
# with a dev buy; without it the launch page only allows launches without one.
# Create it once with: node scripts/create-lookup-table.mjs --keypair <operator.json>
# QUANTPAD_LOOKUP_TABLE=

# Quantum Hooks keeper: posts Entanglement epochs and runs pulses, burns and Fusion.
# Base58 secret key or a JSON byte array. It must match the `keeper` set in the on-chain config.
# It is a hot wallet: fund it about a week ahead at a time (docs/DEPLOY.md, "Keeper SOL"), and on
# Vercel set it for the Production environment only.
# QUANTPAD_KEEPER_SECRET=

# Secret for the cron endpoint GET /api/keeper/tick (Vercel sends it automatically as a Bearer token).
# At least 16 random characters. Set the same value as the CRON_SECRET repository secret on GitHub,
# which the backup schedule (.github/workflows/keeper-cron.yml) sends.
# CRON_SECRET=

# $QUANTP payout engine (docs/DEPLOY.md, "$QUANTP payout engine"): the secret key of the wallet
# pinned in QUANTP.engine.wallet, base58 or a JSON byte array. A hot wallet: set it in Vercel's
# Production environment only, never commit a value, and keep in the wallet only what the engine
# should pay out and burn.
# QUANTP_ENGINE_SECRET=
# 1 pauses the engine (redeploy after changing it): it sends nothing, and /api/quantp/engine
# reports reason `paused`.
# QUANTP_ENGINE_PAUSED=
# Optional webhook URL (for example a Discord channel's webhook) that the keeper tick posts a
# one-line alert to when a payout run fails or stops early, or the keeper finds an epoch it did
# not post. At most one post per reason per hour from each server instance. Anyone with the URL
# can post to the channel: Production only, never commit it.
# QUANTP_ALERT_WEBHOOK=

# Persistent storage. Required on Vercel; omit for a single long-running server.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=configure-in-host-secrets
# QUANTPAD_STORAGE_PREFIX=production
QUANTPAD_DATA_DIR=.quantpad-data
# Total storage for artwork and metadata documents. Uploads stay pending for 24 h and are kept only
# once a launch using them registers (or its coin is first read); abandoned ones expire.
QUANTPAD_MEDIA_LIMIT_MB=256
# Each visitor's daily upload budget for artwork and metadata. Every upload counts at least 128 KB.
# QUANTPAD_MEDIA_CLIENT_MB=16

# Indexer tuning (defaults shown). getTransaction calls per batch request (drops to single
# requests by itself when a provider refuses batches), transactions read per address per pass,
# time budget of one pass in ms (default 15000 on Vercel, 40000 elsewhere; the pass's lease lasts
# 45 s longer) and the most native Quant Pad launches kept in the coin list (hidden mints do not
# count; at the cap, non-Quantum launches created more than 7 days ago with no trade, or under
# 1 SOL of volume, in the last 7 days are evicted, up to 10 at a time, before /api/launches answers
# 429 launch_cap), and the native launches one wallet may register per UTC day (0 turns it off).
# QUANTPAD_RPC_BATCH=10
# QUANTPAD_INDEX_BATCH=40
# QUANTPAD_SYNC_MS=40000
# With Redis on Vercel: at most one request-driven index pass per this many ms, deployment-wide
# (default 60000; 0 turns the spacing off). Each pass costs ~15 Redis commands per coin.
# QUANTPAD_BACKGROUND_SYNC_MS=60000
# QUANTPAD_MAX_LAUNCHES=2000
# QUANTPAD_LAUNCHES_PER_WALLET=10

# Optional IPFS pinning for artwork and metadata (recommended: URIs survive a domain change).
# Pins are made when metadata is published (two per launch); each visitor may create
# QUANTPAD_PIN_CLIENT_DAILY new pins per day, and the whole deployment QUANTPAD_PIN_DAILY (past
# it, 429 PIN_QUOTA until the next UTC day).
# PINATA_JWT=
# QUANTPAD_PIN_CLIENT_DAILY=24
# QUANTPAD_PIN_DAILY=400
# QUANTPAD_IPFS_GATEWAY=https://ipfs.io/ipfs

# Moderation: comma-separated mints hidden from Quant Pad's own pages.
# QUANTPAD_HIDDEN_MINTS=
# Comma-separated mints launched outside Quant Pad's launch flow (test launches, say) that its
# home page, market, tape and stats show anyway. A hidden mint stays hidden.
# QUANTPAD_LISTED_MINTS=

# HOST=127.0.0.1
# PORT=5173
# Number of reverse proxies in front of `npm start` (1 for a single nginx or Caddy). Rate limits
# then key on the visitor address from X-Forwarded-For, and X-Forwarded-Proto: https turns on HSTS.
# Leave unset when clients connect directly.
# QUANTPAD_TRUST_PROXY=1
