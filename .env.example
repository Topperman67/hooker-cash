# Server-only configuration. Never place credentials in VITE_ variables.
HOOKBREW_PUBLIC_URL=https://hookbrew.tech
# Public default for preparation. Use a dedicated Robinhood archive endpoint in production.
HOOKBREW_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# A 4663-v2 subdirectory is appended automatically for filesystem hosting.
HOOKBREW_DATA_DIR=.hookbrew-data
# Optional environment prefix; hookbrew:4663:v2 is ALWAYS appended.
# HOOKBREW_STORAGE_PREFIX=production
HOOKBREW_MEDIA_LIMIT_MB=256
# Required for Vercel; omit for a local filesystem server.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=configure-in-host-secrets
# HOST=127.0.0.1
# PORT=5173
# Optional read-only source for local mainnet-fork rehearsals.
# HOOKBREW_FORK_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# HOOKBREW_FORK_BLOCK=123456
# Local source-publication command only; never expose this key to the browser.
# BLOCKSCOUT_API_KEY=configure-in-your-shell-or-secret-manager
