# Server-only configuration. Never put secrets in VITE_ variables.

# Public origin. Token metadata URIs are written on-chain and must keep resolving forever.
QUANTPAD_PUBLIC_URL=https://your-domain.example

# Solana RPC used by the server and the browser proxy (/api/rpc). Use a provider endpoint
# (Helius, Triton, QuickNode…) in production; the public endpoint is heavily rate limited.
# QUANTPAD_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Platform trading fee, charged as a visible transfer on trades and dev buys made in Quant Pad.
# Off unless a treasury is set. Basis points, capped at 200 (2%).
# QUANTPAD_TREASURY=YourTreasuryWalletAddress
# QUANTPAD_FEE_BPS=50

# Address lookup table that lets a launch + dev buy fit in one transaction.
# Create it once with: node scripts/create-lookup-table.mjs --keypair <operator.json>
# QUANTPAD_LOOKUP_TABLE=

# Quantum Hooks keeper: posts Entanglement epochs and runs pulses, burns and Fusion.
# Base58 secret key or a JSON byte array. Fund it with a little SOL for fees. It must match
# the `keeper` set in the on-chain config.
# QUANTPAD_KEEPER_SECRET=

# Secret for the cron endpoint GET /api/keeper/tick (Vercel sends it automatically as a Bearer token).
# CRON_SECRET=

# Persistent storage. Required on Vercel; omit for a single long-running server.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=configure-in-host-secrets
# QUANTPAD_STORAGE_PREFIX=production
QUANTPAD_DATA_DIR=.quantpad-data
QUANTPAD_MEDIA_LIMIT_MB=256

# Optional IPFS pinning for artwork and metadata (recommended: URIs survive a domain change).
# PINATA_JWT=
# QUANTPAD_IPFS_GATEWAY=https://ipfs.io/ipfs

# Moderation: comma-separated mints hidden from Quant Pad's own pages.
# QUANTPAD_HIDDEN_MINTS=

# HOST=127.0.0.1
# PORT=5173
