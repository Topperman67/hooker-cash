{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/[[...path]].js": {
      "includeFiles": "{server/**,src/generated/**,src/lib/hookRecipe.js,public/protocol/**}",
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[[...path]]" },
    { "source": "/media/:path*", "destination": "/api/[[...path]]" },
    { "source": "/((?!api/|media/).*)", "destination": "/index.html" }
  ]
}
