{
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/[[...path]].js": {
      "includeFiles": "{shared/**,server/**}",
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/keeper/tick",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/keeper/tick",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/keeper/tick",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/keeper/tick",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/keeper/tick",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/keeper/tick",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/keeper/tick",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/keeper/tick",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/keeper/tick",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/keeper/tick",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/keeper/tick",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/keeper/tick",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/keeper/tick",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/keeper/tick",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/keeper/tick",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/keeper/tick",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/keeper/tick",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/keeper/tick",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/keeper/tick",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/keeper/tick",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/keeper/tick",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/keeper/tick",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/keeper/tick",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/keeper/tick",
      "schedule": "0 23 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[[...path]]"
    },
    {
      "source": "/media/:path*",
      "destination": "/api/[[...path]]"
    },
    {
      "source": "/m/:path*",
      "destination": "/api/[[...path]]"
    },
    {
      "source": "/((?!api/|media/|m/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
